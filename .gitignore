# Python bytecode caches. Generated by the python steps in the test chain, which
# is how scripts/__pycache__/fetch_population.cpython-314.pyc came to be tracked
# with no source consumer. Git classified it binary, which is also how it turned
# up in the P1.1 control-byte inventory.
__pycache__/
*.py[cod]

    {
      "id": "nibrs-003",
      "tab": "nibrs",
      "question": "Motor vehicle theft trend in Houston 2020-2023",
      "checks": {
        "sql_patterns": ["240"],
        "min_rows": 2
      }
    },
    {
      "id": "nibrs-004",
      "tab": "nibrs",
      "question": "Top 10 cities by robbery count in 2022",
      "checks": {
        "sql_patterns": ["120"],

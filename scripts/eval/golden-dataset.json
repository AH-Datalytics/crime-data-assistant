        "sql_patterns": ["population", "historical_agency"],
        "min_rows": 20
      }
    },
    {
      "id": "hist-005a",
      "tab": "historical",
      "question": "Total law enforcement officers in Texas since 1990",
      "checks": {
        "expect_clarification": true,

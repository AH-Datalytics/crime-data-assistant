{
  "version": "1.0",
  "description": "Golden dataset for evaluating Crime Data Assistant (nibrsai.com). Each test has a question, expected SQL patterns, and optionally expected data values to validate correctness.",
  "tests": [
    {
      "id": "rtci-001",
      "tab": "current",
      "question": "National murder trend",
      "checks": {
        "sql_patterns": ["national_monthly", "murder"],
        "sql_antipatterns": ["agency_monthly"],
        "min_rows": 5,
        "chart_type": "line"
      }
    },
    {
      "id": "rtci-002",
      "tab": "current",
      "question": "Murder rate in Houston per 100K",
      "checks": {
        "sql_patterns": ["population", "100000", "houston"],
        "min_rows": 1,
        "chart_type": "line"
      }
    },
    {
      "id": "rtci-003",
      "tab": "current",
      "question": "Compare monthly murders in Baltimore and Detroit",
      "checks": {
        "sql_patterns": ["case"],
        "min_rows": 5,
        "chart_type": "line"
      }
    },
    {
      "id": "rtci-004",
      "tab": "current",
      "question": "Total murders nationally in 2023",
      "checks": {
        "sql_patterns": ["national_monthly", "murder"],
        "min_rows": 1,
        "expected_values": {
          "description": "RTCI national murder total for 2023 (~669 agency sample, not full UCR)",
          "column": null,
          "min": 7000,
          "max": 14000
        }
      }
    },
    {
      "id": "rtci-005a",
      "tab": "current",
      "question": "Which city has the highest murder rate per 100K in 2024?",
      "checks": {
        "expect_clarification": true,
        "_note": "Agent should refuse vague ranking across all cities — dataset only covers ~700 agencies"
      }
    },
    {
      "id": "rtci-005b",
      "tab": "current",
      "question": "Murder rate per 100K in Memphis in 2024",
      "checks": {
        "sql_patterns": ["population", "100000", "memphis"],
        "min_rows": 1
      }
    },
    {
      "id": "rtci-006",
      "tab": "current",
      "question": "Motor vehicle theft trend in Los Angeles",
      "checks": {
        "sql_patterns": ["motor vehicle theft"],
        "sql_antipatterns": ["national_monthly"],
        "min_rows": 5,
        "chart_type": "line"
      }
    },
    {
      "id": "rtci-007",
      "tab": "current",
      "question": "Robbery in New York City vs Chicago 2023",
      "checks": {
        "sql_patterns": ["robbery", "case"],
        "min_rows": 1
      }
    },
    {
      "id": "rtci-008",
      "tab": "current",
      "question": "National burglary trend by month in 2024",
      "checks": {
        "sql_patterns": ["national_monthly", "burglary", "2024"],
        "min_rows": 6,
        "chart_type": "line"
      }
    },
    {
      "id": "rtci-009",
      "tab": "current",
      "question": "Top 10 cities by aggravated assault in 2023",
      "checks": {
        "sql_patterns": ["Aggravated Assault"],
        "min_rows": 10,
        "max_rows": 10,
        "chart_type": "bar"
      }
    },
    {
      "id": "rtci-010",
      "tab": "current",
      "question": "Murder rates in Washington DC, Baltimore, and St. Louis per 100K",
      "checks": {
        "sql_patterns": ["population", "100000", "case"],
        "min_rows": 1
      }
    },
    {
      "id": "hist-001",
      "tab": "historical",
      "question": "National murder trend since 1985",
      "checks": {
        "sql_patterns": ["historical_state_national"],
        "min_rows": 20,
        "chart_type": "line"
      }
    },
    {
      "id": "hist-002",
      "tab": "historical",
      "question": "Houston Police Department murder count in 2020",
      "checks": {
        "sql_patterns": ["historical_agency_crime", "houston"],
        "min_rows": 1,
        "expected_values": {
          "description": "Houston PD murders in 2020 should be roughly 380-420",
          "column": null,
          "min": 300,
          "max": 500
        }
      }
    },
    {
      "id": "hist-003",
      "tab": "historical",
      "question": "National robbery clearance rate since 1960",
      "checks": {
        "sql_patterns": ["clearance"],

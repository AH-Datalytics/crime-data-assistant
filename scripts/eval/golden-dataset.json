      "checks": {
        "sql_patterns": ["historical_agency_crime", "case", "New York"],
        "min_rows": 20,
        "min_columns": 3,
        "chart_type": "line"
      }
    },
    {
      "id": "hist-007",
      "tab": "historical",
      "question": "National property crime trend since 1960",
      "checks": {
        "sql_patterns": ["historical_state_national"],
        "min_rows": 30
      }
    },
    {
      "id": "hist-008",

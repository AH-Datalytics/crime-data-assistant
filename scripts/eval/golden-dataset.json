      "tab": "nibrs",
      "question": "Total murder victims nationally in 2022",
      "checks": {
        "sql_patterns": ["summary_victim_state_monthly"],
        "sql_antipatterns": ["FROM VICTIMS", "JOIN VICTIMS"],
        "min_rows": 1,
        "expected_values": {
          "description": "National murders in 2022 NIBRS should be roughly 15,000-22,000",
          "column": null,
          "min": 12000,
          "max": 25000
